# Hospital Management System — Backend Environment Variables
# Copy this file to .env and fill in your values

PORT=5000

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/hospital_db
# Atlas:  mongodb+srv://<username>:<password>@cluster.mongodb.net/hospital_db
MONGO_URI=mongodb://127.0.0.1:27017/hospital_db

# JWT — use a long random secret in production
JWT_SECRET=hospital_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

NODE_ENV=development

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173

